{
  "name": "valor-valet",
  "version": "1.0.0",
  "description": "Valor Valet Waste & Common Area Care — client portal, admin scheduling, and field crew app for a Disabled Veteran Owned Small Business.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning server.js",
    "dev": "node --watch --experimental-sqlite --no-warnings=ExperimentalWarning server.js",
    "seed": "node --experimental-sqlite --no-warnings=ExperimentalWarning src/seed.js --reset",
    "test": "node --experimental-sqlite --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2"
  }
}
