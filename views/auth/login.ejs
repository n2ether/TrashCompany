<%- include('../partials/public-header') %>
<div class="auth">
  <div class="auth__form">
    <div>
      <h1>Sign in</h1>
      <p class="muted">Property clients, contractors, supervisors, and the operations team all sign in here.</p>
      <%- include('../partials/flash') %>
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field mb-2">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="username" required value="<%= email %>">
        </div>
        <div class="field mb-3">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn--gold btn--lg btn--block" type="submit">Sign in</button>
      </form>
      <p class="mt-3 center">New client? <a href="/register"><strong>Create an account</strong></a><br>Want to pick up gigs? <a href="/join"><strong>Apply as a 1099 contractor</strong></a></p>

      <div class="demo-accounts">
        <strong><%- icon('info', 'icon--sm') %> Demo accounts</strong>
        <table>
          <tbody>
            <tr><td>Property client</td><td><button type="button" data-fill-login data-email="manager@oakridgepg.com" data-password="Client2026!">manager@oakridgepg.com</button></td></tr>
            <tr><td>Admin / dispatch</td><td><button type="button" data-fill-login data-email="admin@valorvalet.com" data-password="Admin2026!">admin@valorvalet.com</button></td></tr>
            <tr><td>Field supervisor</td><td><button type="button" data-fill-login data-email="marcus@valorvalet.com" data-password="Crew2026!">marcus@valorvalet.com</button></td></tr>
            <tr><td>Technician</td><td><button type="button" data-fill-login data-email="tyrell@valorvalet.com" data-password="Crew2026!">tyrell@valorvalet.com</button></td></tr>
            <tr><td>1099 contractor</td><td><button type="button" data-fill-login data-email="andre@valorvalet.com" data-password="Contractor2026!">andre@valorvalet.com</button></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="auth__panel">
    <span class="eyebrow eyebrow--gold"><%- icon('flag', 'icon--sm') %> Disabled Veteran Owned</span>
    <h2>Your community, handled.</h2>
    <ul class="check-list">
      <li><%- icon('checkCircle') %><span>Request valet trash, bulk removal, and common area cleanup</span></li>
      <li><%- icon('checkCircle') %><span>Track every request from submitted to completed</span></li>
      <li><%- icon('checkCircle') %><span>See tonight's route and upcoming service for each property</span></li>
      <li><%- icon('checkCircle') %><span>Manage your team, properties, and invoices</span></li>
    </ul>
    <p class="mb-0"><%- icon('heart') %> A portion of our profits supports homeless veteran housing programs.</p>
  </div>
</div>
<%- include('../partials/public-footer') %>
