<%- include('../partials/public-header') %>
<section class="error-page">
  <div>
    <%- icon('alert', 'icon--xl') %>
    <h1><%= title %></h1>
    <p class="lead" style="margin-inline:auto"><%= message %></p>
    <div class="btn-row mt-3" style="justify-content:center">
      <a class="btn" href="<%= user ? (user.role === 'admin' ? '/admin' : user.role === 'client' ? '/portal' : '/crew') : '/' %>">Go to <%= user ? 'my dashboard' : 'home' %></a>
      <a class="btn btn--outline" href="javascript:history.back()">Go back</a>
    </div>
  </div>
</section>
<%- include('../partials/public-footer') %>
