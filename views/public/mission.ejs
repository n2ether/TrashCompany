<%- include('../partials/public-header') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow--gold"><%- icon('flag', 'icon--sm') %> Our mission</span>
    <h1>Service doesn't end when the uniform comes off</h1>
    <p class="lead">Valor Valet is a Disabled Veteran Owned Small Business. We bring the discipline, accountability, and pride of military service to every community we clean, and we put part of what we earn toward getting homeless veterans off the street and into a home.</p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="feature-row">
      <div>
        <span class="eyebrow">Giving back</span>
        <h2>A portion of our profits funds homeless veteran housing</h2>
        <p class="lead">Too many of the men and women who served our country are without a place to live. We think a business built by a veteran should help change that.</p>
        <p>Every quarter, a portion of Valor Valet's profits goes to programs that provide housing and supportive services to homeless veterans, including transitional housing, rapid re-housing, and permanent supportive housing programs in the communities we serve.</p>
        <p>When you choose Valor Valet, your community's trash service becomes part of that mission. No extra cost, no extra paperwork.</p>
        <a class="btn btn--gold" href="/contact">Partner with us</a>
      </div>
      <div class="illustration-card">
        <h3><%- icon('heart') %> How your partnership helps</h3>
        <ul class="check-list mb-0">
          <li><%- icon('checkCircle') %><span><strong>Housing first.</strong> Support for programs that place veterans in stable homes.</span></li>
          <li><%- icon('checkCircle') %><span><strong>Local impact.</strong> We prioritize organizations in the regions where we work.</span></li>
          <li><%- icon('checkCircle') %><span><strong>Veteran hiring.</strong> We actively recruit veterans and military spouses for our crews.</span></li>
          <li><%- icon('checkCircle') %><span><strong>Transparency.</strong> Clients can ask us about our giving partners at any time.</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head"><span class="eyebrow">Our values</span><h2>How we operate</h2></div>
    <div class="grid-3">
      <div class="card"><h3><%- icon('shield') %> Accountability</h3><p class="mb-0">A supervisor leads every crew, and every job is documented. If something is missed, we own it and fix it.</p></div>
      <div class="card"><h3><%- icon('clock') %> Reliability</h3><p class="mb-0">We show up on schedule, every service night, in uniform. Your residents can set their watch by us.</p></div>
      <div class="card"><h3><%- icon('users') %> Respect</h3><p class="mb-0">For residents, for onsite teams, and for the communities we serve. Quiet, courteous, and professional.</p></div>
    </div>
  </div>
</section>

<section class="section section--navy">
  <div class="container center">
    <span class="eyebrow eyebrow--gold">Disabled Veteran Owned Small Business</span>
    <h2>Working with a DVOSB</h2>
    <p class="lead" style="margin-inline:auto">Many owners, REITs, and public housing partners have supplier diversity goals. Partnering with a Disabled Veteran Owned Small Business can help you meet them, while giving your residents a better amenity.</p>
    <div class="btn-row mt-3" style="justify-content:center"><a class="btn btn--gold btn--lg" href="/contact">Request a capabilities statement</a></div>
  </div>
</section>

<%- include('../partials/public-footer') %>
