<%- include('../partials/app-start') %>
<div class="page-head"><div><h1>Clients</h1><p>Management companies and ownership groups under contract.</p></div></div>
<div class="card card--flush">
  <div class="table-wrap">
    <table class="table table--stack">
      <thead><tr><th>Client</th><th>Plan</th><th>Properties</th><th>Doors</th><th>Open requests</th><th>Status</th></tr></thead>
      <tbody>
        <% clients.forEach(function (c) { %>
          <tr>
            <td data-label=""><a class="row-link" href="/admin/clients/<%= c.id %>"><%= c.name %></a><div class="muted small"><%= c.primary_contact || '' %></div></td>
            <td data-label="Plan"><%= c.plan %></td>
            <td data-label="Properties"><%= c.property_count %></td>
            <td data-label="Doors"><%= c.doors.toLocaleString() %></td>
            <td data-label="Open requests"><%= c.open_requests %></td>
            <td data-label="Status"><span class="badge badge--<%= c.status === 'active' ? 'success' : c.status === 'paused' ? 'amber' : 'info' %>"><%= c.status.charAt(0).toUpperCase() + c.status.slice(1) %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/app-end') %>
